generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  memberships   OrganizationMember[]
  ownedOrgs     Organization[] @relation("OrganizationOwner")
  barber        Barber?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model Profile {
  id           String   @id
  fullName     String?
  businessName String?
  role         String   @default("professional")
  theme        String   @default("barbershop")
  logoUrl      String?
  timezone     String   @default("America/Bogota")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Organization {
  id            String                 @id @default(cuid())
  ownerId       String
  name          String
  slug          String                 @unique
  theme         String                 @default("barbershop")
  timezone      String                 @default("America/Bogota")
  phone         String                 @default("")
  address       String                 @default("")
  subscriptionStatus String            @default("trialing")
  trialEndsAt   DateTime?
  currentPeriodEnd DateTime?
  agentApiKeyHash String?              @unique
  agentApiKeyHint String?
  privacyPolicyUrl String               @default("")
  setupPaidAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  owner         User                   @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members       OrganizationMember[]
  services      Service[]
  availability  WeeklyAvailability[]
  exceptions    AvailabilityException[]
  bookings      Booking[]
  barbers       Barber[]
  customers     Customer[]
  payments      PaymentReport[]
  expenses      Expense[]
  @@index([ownerId])
}

model OrganizationMember {
  organizationId String
  userId         String
  role           String   @default("professional")
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([organizationId, userId])
  @@index([userId])
}

model Service {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  description     String       @default("")
  durationMinutes Int
  priceInCents    Int
  currency        String       @default("COP")
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  @@index([organizationId])
}

// Empleados del negocio. Con userId tienen acceso propio al panel (rol "barber" en OrganizationMember).
model Barber {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  phone          String       @default("")
  active         Boolean      @default(true)
  userId         String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings       Booking[]
  @@index([organizationId])
}

// Base de clientes propia de cada negocio (registro opcional, con autorización de tratamiento de datos).
model Customer {
  id              String       @id @default(cuid())
  organizationId  String
  fullName        String
  phone           String
  email           String
  birthDate       String
  source          String       @default("panel")
  consentAt       DateTime
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, phone])
}

// Pagos de la suscripción por transferencia (Nequi): el negocio reporta y el administrador aprueba.
model PaymentReport {
  id             String       @id @default(cuid())
  organizationId String
  amountInCents  Int
  setupInCents   Int          @default(0)
  barbers        Int          @default(1)
  reference      String
  payerName      String
  status         String       @default("pending")
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([organizationId])
}

// Gastos del negocio (solo el dueño). Fecha "YYYY-MM-DD"; valores en pesos enteros; total = cantidad × valor.
model Expense {
  id              String       @id @default(cuid())
  organizationId  String
  date            String
  description     String
  quantity        Float
  unitPrice       Int
  total           Int
  supplier        String
  responsible     String
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, date])
}

model WeeklyAvailability {
  id             String       @id @default(cuid())
  organizationId String
  weekday        Int
  startsAt       String
  endsAt         String
  breakStartsAt  String?
  breakEndsAt    String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, weekday])
}

model AvailabilityException {
  id             String       @id @default(cuid())
  organizationId String
  startsAt       DateTime
  endsAt         DateTime
  reason         String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, startsAt, endsAt])
}

model Booking {
  id             String       @id @default(cuid())
  organizationId String
  serviceId      String
  barberId       String?
  customerName   String
  customerPhone  String
  customerEmail  String       @default("")
  notes          String       @default("")
  startsAt       DateTime
  endsAt         DateTime
  status         String       @default("confirmed")
  priceInCents   Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  barber         Barber?      @relation(fields: [barberId], references: [id], onDelete: SetNull)
  @@index([organizationId, startsAt])
  @@index([barberId])
  @@index([serviceId])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}
