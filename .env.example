# Neon PostgreSQL
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
# En producción: https://www.barberia.growingsolutions.online (ambas iguales, sin "/" final)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=

# WhatsApp de soporte para activar planes (pantalla /suscripcion), p. ej. 573001234567
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Redes de Growing Solutions en el footer (se ocultan si están vacías)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Notifications and payments (Fases 5 y 6)
RESEND_API_KEY=
# Remitente de los correos de citas (dominio verificado en Resend), p. ej. "Barbería <citas@growingsolutions.online>"
EMAIL_FROM=
PAYMENT_PROVIDER=

# Correos con acceso a /admin/pagos (separados por coma)
PLATFORM_ADMIN_EMAILS=
# WhatsApp para recibir comprobantes de pago (por defecto, el número de Nequi)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
