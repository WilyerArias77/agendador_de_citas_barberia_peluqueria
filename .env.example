# Neon PostgreSQL
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
# En producción: https://www.barberia.growingsolutions.online (ambas iguales, sin "/" final)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=

# WhatsApp de soporte para activar planes (pantalla /suscripcion), p. ej. 573001234567
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Redes de Growing Solutions en el footer (se ocultan si están vacías)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Notifications and payments (Fases 5 y 6)
RESEND_API_KEY=
# Remitente de los correos de citas (dominio verificado en Resend), p. ej. "Barbería <citas@growingsolutions.online>"
EMAIL_FROM=
PAYMENT_PROVIDER=

# Correos con acceso a /admin/pagos (separados por coma)
PLATFORM_ADMIN_EMAILS=
# WhatsApp para recibir comprobantes de pago (por defecto, el número de Nequi)
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ---------- Asistente de WhatsApp multi-negocio (Meta Cloud API + registro integrado) ----------
# App de Meta (developers.facebook.com → tu app → Configuración → Básica)
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
# ID de la configuración de "Facebook Login for Business" para el registro integrado de WhatsApp
NEXT_PUBLIC_META_ES_CONFIG_ID=
# Versión de Graph API (opcional)
META_GRAPH_VERSION=v24.0
# Token que se pega en Meta al configurar el webhook: https://<dominio>/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
# Cifra los tokens de cada negocio (32+ caracteres aleatorios). Si cambia, hay que reconectar todos los WhatsApp.
WHATSAPP_ENCRYPTION_KEY=
# Flujo "Barbería – Agente de WhatsApp multi-negocio" en n8n
N8N_AGENT_WEBHOOK_URL=https://ain8n.growingup.digital/webhook/barberia-agente
# Mismo valor que la credencial Header Auth (X-Agent-Secret) del webhook en n8n
N8N_SHARED_SECRET=
